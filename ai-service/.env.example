# SmartPM AI service configuration.
# Copy to `.env` (this file is the template) and adjust.

# --- Which provider drives each capability ---------------------------------
# ollama = fully local (default). gemini = Google Gemini cloud API.
AI_CHAT_PROVIDER=ollama
# Keep embeddings LOCAL even when chat runs on Gemini: all stored vectors must come
# from ONE embedding model, so changing this means re-seeding embeddings (db:seed).
AI_EMBED_PROVIDER=ollama

# --- Local (Ollama) --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gemini (only used if a provider above is set to "gemini") -------------
# Get a key from https://aistudio.google.com/apikey and paste it below.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
