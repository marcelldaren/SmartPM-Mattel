PORT=4000
DATABASE_PATH=./data/smartpm.db
JWT_SECRET=change-me-to-a-long-random-string
APPROVAL_THRESHOLD_IDR=500000

# The Python AI service (embeddings, drafting, search synthesis). Model/provider
# selection (Ollama vs Gemini) lives in ai-service/.env, not here.
AI_SERVICE_URL=http://localhost:5001

# Real SMTP sending for part-request/PO emails — optional. Leave SMTP_USER/SMTP_PASS
# blank to keep the simulated "sent" behavior (status flips, nothing actually emailed).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER is
# your Gmail address, SMTP_PASS is a 16-character Gmail "App Password" — NOT your normal
# Gmail password (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
